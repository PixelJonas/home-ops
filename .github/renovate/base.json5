// Shared Renovate preset for home-ops and private-ops. Each repo's
// .github/renovate.json5 extends it via
// "github>PixelJonas/home-ops//.github/renovate/base.json5", so changes here
// apply to both repos.
//
// Manager layout (measured with a local dry run; no image is extracted by two
// managers, which would create conflicting branches):
// - customManagers regex: `repository:` + `tag:` pairs (app-template values
//   inlined in Argo CD Applications).
// - kubernetes: plain `image:` lines in manifests, incl. inline `values: |`
//   blocks (replaces the old `# renovate` marker manager and the broad
//   helm-values patterns that only picked up Job/CronJob images by accident).
// - helm-values: default pattern (values.yaml files) only.
// - argocd: chart versions in Applications.
{
  description: [
    "Supply-chain posture: wide update surface, but nothing newer than a quarantine window. Every update must be at least 3 days old (majors 7) before Renovate creates its branch (internalChecksFilter strict). With the weekly Saturday run the effective delay is 3-10 days.",
    "minimumReleaseAgeBehaviour timestamp-optional: only Docker Hub, GitHub tags/releases, Helm HTTP repos, PyPI/npm and the Terraform registry report release timestamps. Images on ghcr.io, quay.io and lscr.io and OCI Helm charts have none; with the default (timestamp-required) their updates would be held forever without notice. They get only the weekly cadence, no age gate.",
    "Vulnerability-fix PRs bypass the age gate (Renovate default). osvVulnerabilityAlerts adds OSV-sourced fixes on top of GitHub's alerts; container images have no OSV feed.",
    "Changes to this preset take effect only once merged to home-ops main (presets are fetched from the default branch), so a PR touching it can't be previewed by Renovate on its own branch.",
  ],
  extends: [
    "config:recommended",
    "docker:enableMajor",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":enablePreCommit",
    ":automergeDigest",
    "helpers:pinGitHubActionDigestsToSemver",
    ":configMigration",
    "abandonments:recommended",
    // `# renovate: datasource=... depName=...` above `*_VERSION:` env in workflows
    "customManagers:githubActionsVersions",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: ["prIgnoreNotification"],
  rebaseWhen: "conflicted",
  schedule: ["on saturday"],
  minimumReleaseAge: "3 days",
  minimumReleaseAgeBehaviour: "timestamp-optional",
  internalChecksFilter: "strict",
  osvVulnerabilityAlerts: true,
  // PR automerge, not branch automerge: CI (validate-manifests) only runs on pull_request
  // and on main, so a bare Renovate branch never gets checks. Under branch automerge every
  // update sat ~25h (prNotPendingHours) before falling back to a PR anyway. With PRs, GitHub
  // auto-merge (home-ops: required checks) merges as soon as CI is green; private-ops has no
  // branch protection, so Renovate merges it itself on its next (daily) run.
  automergeType: "pr",
  platformAutomerge: true,
  packageRules: [
    {
      description: "Tika 4 dropped /tika/form (TIKA-4809), which paperless-ngx's tika client uses; stay on 3.x like paperless upstream's compose files.",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/apache/tika"],
      allowedVersions: "/^3\\./",
    },
    {
      description: "templates/mariadb-backup dump client must match the Nextcloud chart's bundled MariaDB server (not visible to Renovate), and bitnamilegacy is frozen. Bump it by hand together with the server.",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/bitnamilegacy/mariadb"],
      enabled: false,
    },
    {
      description: "Keep oc within kubectl version skew of the clusters (OpenShift stable-4.x). Revisit when the clusters move to a new major.",
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/openshift/origin-cli"],
      allowedVersions: "/^4\\./",
    },
    {
      description: "node-version for renovate-config-validator: Renovate's engines field is node ^24.11.0. Lift once Renovate supports Node 26.",
      matchManagers: ["github-actions"],
      matchDepNames: ["node"],
      allowedVersions: "<25",
    },
    {
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
    {
      description: "Majors carry the most risk and are reviewed by hand anyway: wait a full week.",
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "7 days",
    },
    {
      description: "Own images: bumped by each project's release workflow (digest-only refs) or deployed from :latest / sha-<commit> tags that Renovate can't order. Lookups only produce dashboard warnings.",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/pixeljonas/**"],
      enabled: false,
    },
    {
      description: "In-cluster OpenShift image registry: not reachable from the Renovate runner.",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^image-registry\\.openshift-image-registry\\.svc[:/]/"],
      enabled: false,
    },
    {
      description: "registry.redhat.io needs Red Hat registry credentials, which the Renovate app doesn't have, so every lookup fails. These images are bumped by hand.",
      matchDatasources: ["docker"],
      matchPackageNames: ["registry.redhat.io/**"],
      enabled: false,
    },
  ],
  argocd: {
    managerFilePatterns: [
      "/^components-apps/.+\\.yaml$/",
      "/^components-infra/.+\\.yaml$/",
    ],
  },
  kubernetes: {
    description: "Plain `image: <repo>:<tag>[@digest]` lines in manifests, including the ones inside Argo CD Applications' inline `values: |` blocks.",
    managerFilePatterns: [
      "/^components-apps/.+\\.yaml$/",
      "/^components-infra/.+\\.yaml$/",
      "/^templates/.+\\.yaml$/",
    ],
  },
  customManagers: [
    {
      description: "Helm-values style `repository:` + `tag:` pairs (e.g. bjw-s app-template values inlined in Argo CD Applications), with an optional pullPolicy line between them and an optional @sha256 digest on the tag. No versioningTemplate: the docker datasource's default docker versioning keeps exact tags (semver-coerced proposed rolling tags like 2.6.5 -> 2.7).",
      customType: "regex",
      managerFilePatterns: [
        "/^components-apps/.+\\.yaml$/",
        "/^components-infra/.+\\.yaml$/",
        "/^templates/.+\\.yaml$/",
      ],
      matchStrings: [
        // prettier-ignore
        "(?:^|\\n) *repository: *['\"]?(?<depName>[^\\s'\"]+)['\"]?\\n(?: *pullPolicy:.*\\n)? *tag: *['\"]?(?<currentValue>[^\\s'\"@#]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
      ],
      datasourceTemplate: "docker",
    },
  ],
}
